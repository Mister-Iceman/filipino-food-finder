# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database backups
/backups

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Claude Code
# Worktrees are local-only scratch space
.claude/worktrees/
# settings.local.json holds per-machine permission grants — not for sharing
.claude/settings.local.json
# mcp.json holds MCP server config, which may include DB connection strings
# Copy .claude/mcp.example.json → .claude/mcp.json and fill in real values locally
.claude/mcp.json

# Scrapers and archives
filam-scraper/
*.zip
